# Local development only. Copy to .env and replace every value before running Compose.
PROJECT_DIR=/absolute/host/and/development-container/path/to/GaussAuthApi
LOCAL_UID=replace_with_output_of_id_u
LOCAL_GID=replace_with_output_of_id_g
POSTGRES_DB=replace_with_local_database_name
POSTGRES_USER=replace_with_local_database_user
POSTGRES_PASSWORD=replace_with_private_development_password
# Optional: ES256 (P-256) private key in PEM form for signing access credentials. Leave empty in Development to use an ephemeral key. Never commit a real key.
SESSIONS_SIGNING_KEY_PEM=
# Development/test only: protected local file for password-recovery instructions. Keep empty outside those environments.
PASSWORD_RECOVERY_DELIVERY_FILE=
# Optional in Development/Testing: persistent directory for ASP.NET Core Data Protection keys. Production-class deployments must set this to durable, secret-grade storage.
DATA_PROTECTION_KEYS_PATH=
# Consumer service credentials are deployment secrets. Define only AuthorizationConsumers__<application-code>__CurrentSecretHash (and optionally RetiringSecretHash) in the ignored .env or secret store; never add plaintext credentials here.
# Private root directory for sanitized profile images (user content). Must be writable by the API user and outside any web root; back it up together with the database. Development default: an ignored .profile-images directory inside the project (bind-mounted via PROJECT_DIR).
PROFILE_IMAGES_ROOT=
# Optional declaration in Development/Testing. Production-class deployments must explicitly set true or false; use true only for durable storage.
PROFILE_IMAGES_STORAGE_IS_PERSISTENT=
# Optional overrides (defaults: 5242880 bytes input/output, 4096x4096 pixels).
PROFILE_IMAGES_MAX_BYTES=
PROFILE_IMAGES_MAX_DIMENSION=
# Global Auth administrator: the stable UserId of an existing user who may perform global administrative operations (user lifecycle, Application registration, consumer secrets, global audit). Leave empty for no global authority. Add more users with additional Administration__GlobalAdministratorUserIds__N entries in the ignored .env or secret store. This replaces the removed SecurityAudit__GlobalReviewerUserId; startup fails if that old key is still set.
GLOBAL_ADMINISTRATOR_USER_ID=
# One-time bootstrap inputs, used only by `dotnet GaussAuth.Api.dll bootstrap-admin`, never by the web host. Prefer BOOTSTRAP_ADMINISTRATOR_PASSWORD_FILE; remove both password values after bootstrap.
BOOTSTRAP_ADMINISTRATOR_EMAIL=
BOOTSTRAP_ADMINISTRATOR_PASSWORD=
BOOTSTRAP_ADMINISTRATOR_PASSWORD_FILE=
BOOTSTRAP_ADMINISTRATOR_FIRST_NAME=
BOOTSTRAP_ADMINISTRATOR_LAST_NAME=
# Optional trusted reverse-proxy addresses/CIDRs. Leave empty for direct development; never set ASPNETCORE_FORWARDEDHEADERS_ENABLED=true.
FORWARDED_HEADERS_KNOWN_PROXIES_0=
FORWARDED_HEADERS_KNOWN_NETWORKS_0=
# Optional administrative limits (defaults: at most 1000 sessions revoked per bulk request, valid 1-10000; 120 administrative requests per 60 seconds).
ADMIN_MAX_BULK_SESSION_REVOCATION=
ADMIN_RATE_LIMIT_PERMITS=
ADMIN_RATE_LIMIT_WINDOW_SECONDS=
